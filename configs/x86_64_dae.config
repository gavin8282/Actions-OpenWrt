# =====================================================================
# Target: x86 / x86_64 (Standard 64-bit PC & Virtual Guests)
# Suitable for Physical x86 Routers (Intel/Realtek NICs) & KVM / PVE / ESXi
# Streamlined with dae eBPF + Docker / ext4 support
# =====================================================================
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y

# 根文件系统与镜像格式支持 (支持 EFI / BIOS, squashfs + ext4)
CONFIG_GRUB_IMAGES=y
CONFIG_GRUB_EFI_IMAGES=y
CONFIG_TARGET_IMAGES_GZIP=y
CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_PARTSIZE=1024

# 虚拟机专用镜像格式支持 (VMware VMDK, VirtualBox VDI, Hyper-V VHDX)
CONFIG_VMDK_IMAGES=y
CONFIG_VDI_IMAGES=y
CONFIG_VHDX_IMAGES=y

# 25.12 APK 避免 PER_DEVICE_ROOTFS 报错
# CONFIG_TARGET_PER_DEVICE_ROOTFS is not set

#######################################################################
#                  KERNEL FEATURES (dae & eBPF)                       #
#######################################################################
CONFIG_KERNEL_DEBUG_INFO=y
# CONFIG_KERNEL_DEBUG_INFO_REDUCED is not set
CONFIG_KERNEL_DEBUG_INFO_BTF=y
CONFIG_KERNEL_DEBUG_INFO_BTF_MODULES=y
CONFIG_KERNEL_KPROBES=y
CONFIG_KERNEL_KPROBE_EVENTS=y
CONFIG_KERNEL_BPF_EVENTS=y
CONFIG_KERNEL_BPF_KPROBE_OVERRIDE=y
CONFIG_KERNEL_CGROUP_BPF=y
CONFIG_KERNEL_XDP_SOCKETS=y

#######################################################################
#                           DAE DEPENDENCIES                          #
#######################################################################
# 自行部署二进制，仅保留内核与网络栈核心依赖
# CONFIG_PACKAGE_dae is not set
# CONFIG_PACKAGE_dae-geoip is not set
# CONFIG_PACKAGE_dae-geosite is not set
# CONFIG_PACKAGE_luci-app-dae is not set
# CONFIG_PACKAGE_luci-i18n-dae-zh-cn is not set

# dae / TProxy & Networking
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_kmod-ifb=y
CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-sched-bpf=y
CONFIG_PACKAGE_kmod-tcp-bbr=y
# CONFIG_PACKAGE_tc-tiny is not set
CONFIG_PACKAGE_tc-full=y
# CONFIG_PACKAGE_ipset is not set
# CONFIG_PACKAGE_ip6tables-nft is not set

# DNS & Nftset 联动支持 (dnsmasq-full 现代架构)
# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_dnsmasq_full_nftset=y
# CONFIG_PACKAGE_dnsmasq_full_ipset is not set

#######################################################################
#                      STORAGE & DISK UTILITIES                       #
#######################################################################
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-extras=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-fs-ext4=y
# CONFIG_PACKAGE_kmod-fs-vfat is not set
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_automount=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_blkid=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_lsblk=y

#######################################################################
#                EXPANDED HARDWARE & NIC DRIVERS                      #
#######################################################################
# Intel (1G / 2.5G / 10G / 40G / 100G + SR-IOV VF)
CONFIG_PACKAGE_kmod-e1000=y
CONFIG_PACKAGE_kmod-e1000e=y
CONFIG_PACKAGE_kmod-igb=y
CONFIG_PACKAGE_kmod-igbvf=y
CONFIG_PACKAGE_kmod-igc=y
CONFIG_PACKAGE_kmod-ixgbe=y
CONFIG_PACKAGE_kmod-ixgbevf=y
CONFIG_PACKAGE_kmod-i40e=y
CONFIG_PACKAGE_kmod-iavf=y
CONFIG_PACKAGE_kmod-ice=y

# Realtek (PCIe 1G / 2.5G / 5G & USB)
CONFIG_PACKAGE_kmod-r8169=y
CONFIG_PACKAGE_kmod-r8168=y
CONFIG_PACKAGE_kmod-r8125=y
CONFIG_PACKAGE_kmod-r8126=y
CONFIG_PACKAGE_kmod-r8152=y

# Broadcom & Aquantia (Server & High-end 10G)
CONFIG_PACKAGE_kmod-tg3=y
CONFIG_PACKAGE_kmod-bnx2=y
CONFIG_PACKAGE_kmod-bnx2x=y
CONFIG_PACKAGE_kmod-atlantic=y

# Mellanox (ConnectX-3 / ConnectX-4 / ConnectX-5 光口卡)
CONFIG_PACKAGE_kmod-mlx4-core=y
CONFIG_PACKAGE_kmod-mlx5-core=y

# USB 常见外置网卡与手机 / 随身 WiFi 共享
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-asix=y
CONFIG_PACKAGE_kmod-usb-net-asix-ax88179=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y

# 核心存储 (SATA AHCI + M.2 NVMe SSD 支持)
CONFIG_PACKAGE_kmod-ata-ahci=y
CONFIG_PACKAGE_kmod-nvme=y

# 虚拟化网卡与驱动 (VirtIO / VMware VMXNET3 / Hyper-V)
CONFIG_PACKAGE_kmod-virtio-net=y
CONFIG_PACKAGE_kmod-virtio-balloon=y
CONFIG_PACKAGE_kmod-virtio-console=y
CONFIG_PACKAGE_kmod-vmxnet3=y

#######################################################################
#                    ZRAM & PERFORMANCE TWEAKS                        #
#######################################################################
CONFIG_PACKAGE_kmod-zram=y
CONFIG_PACKAGE_zram-swap=y

#######################################################################
#                  LUCI BASE & ESSENTIAL APPS                         #
#######################################################################
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-compat=y

# 核心中文语言支持
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-package-zh-cn=y

# 主题美化
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-theme-bootstrap-mod=y

# 常用管理与网络插件
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
CONFIG_PACKAGE_luci-app-ramfree=y
CONFIG_PACKAGE_luci-i18n-ramfree-zh-cn=y

#######################################################################
#                 EXPLICIT EXCLUSIONS (STREAMLINING)                  #
#######################################################################
# CONFIG_PACKAGE_nano is not set
# CONFIG_PACKAGE_htop is not set
# CONFIG_PACKAGE_tcpdump is not set
# CONFIG_PACKAGE_bash is not set
# CONFIG_PACKAGE_ethtool is not set
# CONFIG_PACKAGE_usbutils is not set
# CONFIG_PACKAGE_lsof is not set
# CONFIG_PACKAGE_strace is not set
# CONFIG_PACKAGE_openssh-keygen is not set
CONFIG_PACKAGE_openssh-sftp-server=y

# Strip WireGuard & Injected Packages
# CONFIG_PACKAGE_kmod-wireguard is not set
# CONFIG_PACKAGE_wireguard-tools is not set
# CONFIG_PACKAGE_luci-proto-wireguard is not set
# CONFIG_PACKAGE_luci-app-wireguard is not set
CONFIG_PACKAGE_wget-ssl=y
# CONFIG_PACKAGE_wget-nossl is not set

CONFIG_PACKAGE_iputils-ping=y
CONFIG_PING_LEGACY_SYMLINKS=y

CONFIG_KERNEL_TCP_CONG_BBR=y

CONFIG_KERNEL_DEFAULT_TCP_CONG="bbr"

CONFIG_KERNEL_DEFAULT_BBR=y
