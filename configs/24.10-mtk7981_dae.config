# =====================================================================
# Target: CMCC RAX3000M (MT7981 + SPIM-NAND + DDR4) - OpenWrt 24.10
# Streamlined for dae eBPF & MediaTek Proprietary WiFi / HNAT
# =====================================================================
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_MULTI_PROFILE=y
# CONFIG_TARGET_PER_DEVICE_ROOTFS is not set
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_huasifei_wh3000-emmc=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_abt_asr3000=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_cetron_ct3003=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_cmcc_a10=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_cmcc_rax3000m-emmc=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_cmcc_rax3000m=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_cmcc_xr30-stock=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_h3c_nx30pro=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_imou_lc-hx3001=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_jcg_q30=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_konka_komi-a31=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_livinet_zr-3020=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_mt7981-360-t7-108M=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_mt7981-clt-r30b1=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_mt7981-clt-r30b1-112M=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_xiaomi_mi-router-ax3000t=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_xiaomi_mi-router-ax3000t-stock=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_xiaomi_mi-router-wr30u-112m=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_xiaomi_mi-router-wr30u-stock=y

# 仅保留常用架构 Bootloader
CONFIG_PACKAGE_trusted-firmware-a-mt7981-spim-nand-ddr4=y
CONFIG_PACKAGE_trusted-firmware-a-mt7981-spim-nand-ddr3=y
CONFIG_PACKAGE_trusted-firmware-a-mt7981-emmc-ddr4=y
CONFIG_PACKAGE_trusted-firmware-a-mt7981-emmc-ddr3=y
CONFIG_PACKAGE_trusted-firmware-a-mt7981-spim-nor-ddr4=y
CONFIG_PACKAGE_trusted-firmware-a-mt7981-spim-nor-ddr3=y
CONFIG_PACKAGE_u-boot-mt7981_cmcc_rax3000m-nand=y
CONFIG_PACKAGE_u-boot-mt7981_cmcc_rax3000m-emmc=y
CONFIG_PACKAGE_u-boot-mt7981_h3c_nx30pro=y
CONFIG_PACKAGE_u-boot-mt7981_360_t7=y

# =====================================================================
# Build 优化（关闭开发模式与本机 LLVM 编译）
# =====================================================================
# CONFIG_DEVEL is not set
# CONFIG_TOOLCHAINOPTS is not set
# CONFIG_BUSYBOX_CUSTOM is not set
# CONFIG_BPF_TOOLCHAIN_BUILD_LLVM is not set
# CONFIG_NEED_BPF_TOOLCHAIN is not set
# CONFIG_USE_LLVM_BUILD is not set

# 内核 BTF / eBPF 支持（dae 长期稳定运行需要）
CONFIG_KERNEL_DEBUG_INFO=y
# CONFIG_KERNEL_DEBUG_INFO_REDUCED is not set
CONFIG_KERNEL_DEBUG_INFO_BTF=y
CONFIG_KERNEL_DEBUG_INFO_BTF_MODULES=y
CONFIG_KERNEL_KPROBES=y
CONFIG_KERNEL_KPROBE_EVENTS=y
CONFIG_KERNEL_BPF_EVENTS=y
CONFIG_KERNEL_BPF_KPROBE_OVERRIDE=y
CONFIG_KERNEL_CGROUP_BPF=y
CONFIG_KERNEL_XDP_SOCKETS=y

# =====================================================================
# DAE 运行依赖 (自行部署二进制，仅保留内核与网络栈)
# =====================================================================
# CONFIG_PACKAGE_dae is not set
# CONFIG_PACKAGE_dae-geoip is not set
# CONFIG_PACKAGE_dae-geosite is not set
# CONFIG_PACKAGE_luci-app-dae is not set
# CONFIG_PACKAGE_luci-i18n-dae-zh-cn is not set

# dae / TProxy 相关依赖
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_kmod-ifb=y
CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-sched-bpf=y
# CONFIG_PACKAGE_tc-tiny is not set
CONFIG_PACKAGE_tc-full=y
# CONFIG_PACKAGE_ipset is not set
# CONFIG_PACKAGE_ip6tables-nft is not set

# DNS & Nftset 联动支持 (dnsmasq-full 现代架构)
# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_dnsmasq_full_nftset=y
# CONFIG_PACKAGE_dnsmasq_full_ipset is not set

# =====================================================================
# USB + 仅 ext4 支持
# =====================================================================
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-extras=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_automount=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_blkid=y
CONFIG_PACKAGE_blockdev=y

# 512MB RAM 建议开启 zram
CONFIG_PACKAGE_kmod-zram=y
CONFIG_PACKAGE_zram-swap=y

# =====================================================================
# 联发科 WiFi + 硬件加速底层芯片与驱动宏（避免 apconninfra undefined）
# =====================================================================
CONFIG_PACKAGE_kmod-conninfra=y
CONFIG_CONNINFRA_AUTO_UP=y
CONFIG_CONNINFRA_EMI_SUPPORT=y
CONFIG_PACKAGE_kmod-mediatek_hnat=y
CONFIG_PACKAGE_kmod-mt_wifi=y
CONFIG_PACKAGE_kmod-warp=y
CONFIG_PACKAGE_ebtables=y
CONFIG_PACKAGE_kmod-ebtables=y
CONFIG_PACKAGE_kmod-ebtables-ipv4=y
CONFIG_PACKAGE_kmod-ebtables-ipv6=y

CONFIG_PACKAGE_luci-app-mtwifi-cfg=y
CONFIG_PACKAGE_luci-app-turboacc-mtk=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y
CONFIG_PACKAGE_luci-i18n-opkg-zh-cn=y
CONFIG_PACKAGE_luci-i18n-turboacc-mtk-zh-cn=y
CONFIG_PACKAGE_luci-i18n-mtwifi-cfg-zh-cn=y

CONFIG_MTK_ACK_CTS_TIMEOUT_SUPPORT=y
CONFIG_MTK_AIR_MONITOR=y
CONFIG_MTK_AMPDU_CONF_SUPPORT=y
CONFIG_MTK_ANTENNA_CONTROL_SUPPORT=y
CONFIG_MTK_APCLI_SUPPORT=y
CONFIG_MTK_ATE_SUPPORT=y
